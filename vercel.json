{
  "services": {
    "web": {
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "server": {
      "framework": "node",
      "entrypoint": "server/vercel.ts"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/auth/(.*)", "destination": { "service": "server" } },
    { "source": "/ws", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
